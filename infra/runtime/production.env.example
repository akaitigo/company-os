# Copy outside the repository and replace every value. Secret files must be UID 10001 owned, operator-group readable, and mode 0440. Database URLs use sslrootcert=/run/secrets/database_ca.crt.
API_IMAGE=registry.example.invalid/company-os/api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WORKER_IMAGE=registry.example.invalid/company-os/worker@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
WEB_IMAGE=registry.example.invalid/company-os/web@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
DATABASE_URL_SECRET_FILE=/secure/company-os/database-url
DATABASE_CA_CERT_FILE=/secure/company-os/database-ca.crt
MIGRATION_DATABASE_URL_SECRET_FILE=/secure/company-os/migration-database-url
SESSION_SECRET_SECRET_FILE=/secure/company-os/session-secret
MIGRATION_BACKUP_SIGNING_KEY_FILE=/secure/company-os/migration-backup-signing-key
DEPLOYMENT_PROFILE=SMB
OIDC_ISSUER=https://id.example.invalid/realms/company-os
OIDC_AUDIENCE=company-os-api
OIDC_CLIENT_ID=company-os-web
OIDC_REDIRECT_URI=https://company.example.invalid/auth/callback
API_INTERNAL_URL=http://api:3001
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid:4318
WEB_ARTIFACT_DIR=/opt/company-os/release/dist/web
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
