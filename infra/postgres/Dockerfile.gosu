# Rebuild the upstream gosu 1.19 source with a Go release fixed for
# CVE-2025-68121 while retaining the pinned PostgreSQL 18.4 base.
FROM golang:1.24.13-alpine3.22@sha256:3641e0d9b931dc4f2f185dcd669c4679670e9277c8166a838ddb98a2d4389cb5 AS gosu-build
RUN apk add --no-cache git
RUN git init /src/gosu \
    && git -C /src/gosu fetch --depth 1 https://github.com/tianon/gosu.git 6456aaa0f3c854d199d0f037f068eb97515b7513 \
    && git -C /src/gosu checkout --detach FETCH_HEAD \
    && test "$(git -C /src/gosu rev-parse HEAD)" = 6456aaa0f3c854d199d0f037f068eb97515b7513
WORKDIR /src/gosu
RUN go mod download \
    && CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /tmp/gosu . \
    && go version -m /tmp/gosu | grep -F 'go1.24.13'

FROM postgres:18.4-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
COPY --from=gosu-build --chmod=0755 /tmp/gosu /usr/local/bin/gosu
RUN gosu --version && gosu nobody true
USER postgres
