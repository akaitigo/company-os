#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"
docker compose up -d --wait postgres
pnpm --filter @company-os/worker build >/dev/null

worker_log="$(mktemp)"
worker_pid=''
cleanup() {
  if [[ -n "$worker_pid" ]] && kill -0 "$worker_pid" 2>/dev/null; then
    kill -TERM "$worker_pid"
    wait "$worker_pid" || true
  fi
  rm -f "$worker_log"
}
trap cleanup EXIT

DATABASE_URL='postgresql://company_os:local-development-only@127.0.0.1:5432/company_os' \
WORKER_HEALTH_PORT=3012 node apps/worker/dist/main.js >"$worker_log" 2>&1 &
worker_pid="$!"

for _ in {1..30}; do
  if curl --fail --silent http://127.0.0.1:3012/health/ready >/dev/null; then break; fi
  sleep 0.2
done
curl --fail --silent http://127.0.0.1:3012/health/ready >/dev/null

docker compose stop postgres >/dev/null
for _ in {1..40}; do
  status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
    http://127.0.0.1:3012/health/ready || true)"
  if [[ "$status" == '503' ]]; then break; fi
  sleep 0.25
done
[[ "$status" == '503' ]]
kill -0 "$worker_pid"

docker compose start postgres >/dev/null
for _ in {1..60}; do
  if curl --fail --silent http://127.0.0.1:3012/health/ready >/dev/null; then break; fi
  sleep 0.25
done
curl --fail --silent http://127.0.0.1:3012/health/ready >/dev/null
kill -0 "$worker_pid"

read -r event_id < /proc/sys/kernel/random/uuid
read -r unit_id < /proc/sys/kernel/random/uuid
docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U company_os -d company_os -c \
  "INSERT INTO integration.outbox
     (tenant_id,id,idempotency_key,event_type,aggregate_id,aggregate_version,payload,occurred_at)
   VALUES ('11111111-1111-4111-8111-111111111111','$event_id','worker-recovery-$event_id',
           'organization.unit.created.v1','$unit_id',1,
           '{\"code\":\"RECOVERY\",\"name\":\"Recovery verification\"}',clock_timestamp())
   ON CONFLICT DO NOTHING" >/dev/null
for _ in {1..40}; do
  projected="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
    "SELECT count(*) FROM projection.organization_unit_directory
      WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND unit_id='$unit_id'")"
  if [[ "$projected" == '1' ]]; then break; fi
  sleep 0.25
done
[[ "$projected" == '1' ]]
grep -q 'worker.database.retry' "$worker_log"
grep -q 'worker.database.recovered' "$worker_log"
echo 'Worker recovered from PostgreSQL restart and delivered the queued event.'
