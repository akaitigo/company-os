#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"
docker compose up -d keycloak postgres
curl --fail --silent --retry 30 --retry-all-errors --retry-delay 2 --max-time 3 \
  http://127.0.0.1:8080/realms/company-os/.well-known/openid-configuration >/dev/null
./scripts/seed-demo >/dev/null
random_id=''
read -r random_id < /proc/sys/kernel/random/uuid
export E2E_USER_PASSWORD="${E2E_USER_PASSWORD:-${random_id//-/}}"
keycloak_admin=(docker compose exec -T keycloak /opt/keycloak/bin/kcadm.sh)
"${keycloak_admin[@]}" config credentials --server http://localhost:8080 --realm master \
  --user admin --password local-development-only >/dev/null
"${keycloak_admin[@]}" get users/profile -r company-os | jq \
  'if any(.attributes[]; .name == "tenant_id") then . else .attributes += [{"name":"tenant_id","displayName":"Tenant ID","permissions":{"view":["admin","user"],"edit":["admin"]},"multivalued":false}] end' | \
  "${keycloak_admin[@]}" update users/profile -r company-os -f -
for required_role in workforce-employee workforce-hr; do
  if ! "${keycloak_admin[@]}" get "roles/$required_role" -r company-os >/dev/null 2>&1; then
    "${keycloak_admin[@]}" create roles -r company-os -s name="$required_role" >/dev/null
  fi
done
mapfile -t existing_user_ids < <(
  "${keycloak_admin[@]}" get users -r company-os -q username=e2e-user -q exact=true | jq -r '.[].id'
)
for existing_user_id in "${existing_user_ids[@]}"; do
  "${keycloak_admin[@]}" delete "users/$existing_user_id" -r company-os >/dev/null
done
"${keycloak_admin[@]}" create users -r company-os -s username=e2e-user -s enabled=true \
  -s email=e2e-user@example.invalid -s emailVerified=true -s firstName=E2E -s lastName=User \
  -s 'attributes."tenant_id"=["11111111-1111-4111-8111-111111111111"]' >/dev/null
e2e_user_id="$("${keycloak_admin[@]}" get users -r company-os -q username=e2e-user --fields id --format csv --noquotes | tail -n 1)"
"${keycloak_admin[@]}" set-password -r company-os --username e2e-user --new-password "$E2E_USER_PASSWORD" >/dev/null
for role in organization-admin workforce-manager procurement-buyer finance-accountant; do
  "${keycloak_admin[@]}" add-roles -r company-os --uusername e2e-user --rolename "$role" >/dev/null
done
for username in employee-e2e manager-employee-e2e hr-e2e; do
  mapfile -t existing_user_ids < <(
    "${keycloak_admin[@]}" get users -r company-os -q username="$username" -q exact=true | jq -r '.[].id'
  )
  for existing_user_id in "${existing_user_ids[@]}"; do
    "${keycloak_admin[@]}" delete "users/$existing_user_id" -r company-os >/dev/null
  done
  "${keycloak_admin[@]}" create users -r company-os -s username="$username" -s enabled=true \
    -s email="$username-$random_id@example.invalid" -s emailVerified=true -s firstName=E2E -s lastName="$username" \
    -s 'attributes."tenant_id"=["11111111-1111-4111-8111-111111111111"]' >/dev/null
  "${keycloak_admin[@]}" set-password -r company-os --username "$username" \
    --new-password "$E2E_USER_PASSWORD" >/dev/null
done
employee_user_id="$("${keycloak_admin[@]}" get users -r company-os -q username=employee-e2e --fields id --format csv --noquotes | tail -n 1)"
manager_employee_user_id="$("${keycloak_admin[@]}" get users -r company-os -q username=manager-employee-e2e --fields id --format csv --noquotes | tail -n 1)"
hr_user_id="$("${keycloak_admin[@]}" get users -r company-os -q username=hr-e2e --fields id --format csv --noquotes | tail -n 1)"
"${keycloak_admin[@]}" add-roles -r company-os --uusername employee-e2e --rolename workforce-employee >/dev/null
"${keycloak_admin[@]}" add-roles -r company-os --uusername manager-employee-e2e --rolename workforce-manager >/dev/null
"${keycloak_admin[@]}" add-roles -r company-os --uusername hr-e2e --rolename workforce-hr >/dev/null
docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U company_os -d company_os -c \
  "INSERT INTO workforce.employment_access
    (tenant_id,actor_id,employment_id,access_type,granted_at,granted_by)
   VALUES ('11111111-1111-4111-8111-111111111111','$e2e_user_id',
           '10000000-0000-4000-8000-000000000003','manager',clock_timestamp(),'$e2e_user_id')
   ON CONFLICT DO NOTHING" >/dev/null
docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U company_os -d company_os -c \
  "INSERT INTO workforce.attendance_period_events
    (tenant_id,id,employment_id,period_month,sequence,action,reason,actor_id)
   SELECT '11111111-1111-4111-8111-111111111111',gen_random_uuid(),
          '10000000-0000-4000-8000-000000000003','2027-01-01',1,'reopen',
          'E2E setup reopens prior interrupted run','$hr_user_id'
     FROM (
       SELECT action FROM workforce.attendance_period_events
        WHERE tenant_id='11111111-1111-4111-8111-111111111111'
          AND employment_id='10000000-0000-4000-8000-000000000003'
          AND period_month='2027-01-01'
        ORDER BY sequence DESC LIMIT 1
     ) current
    WHERE current.action='close'
   ON CONFLICT DO NOTHING" >/dev/null
docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U company_os -d company_os -c \
  "INSERT INTO workforce.employment_access
    (tenant_id,actor_id,employment_id,access_type,granted_at,granted_by)
   VALUES
    ('11111111-1111-4111-8111-111111111111','$employee_user_id',
     '10000000-0000-4000-8000-000000000003','employee',clock_timestamp(),'$employee_user_id'),
    ('11111111-1111-4111-8111-111111111111','$manager_employee_user_id',
     '10000000-0000-4000-8000-000000000003','employee',clock_timestamp(),'$manager_employee_user_id'),
    ('11111111-1111-4111-8111-111111111111','$hr_user_id',
     '10000000-0000-4000-8000-000000000003','hr',clock_timestamp(),'$hr_user_id')
   ON CONFLICT DO NOTHING" >/dev/null
export SESSION_SECRET="${SESSION_SECRET:-local-e2e-session-secret-at-least-32-characters}"
export DATABASE_URL="${E2E_DATABASE_URL:-postgresql://company_os:local-development-only@127.0.0.1:5432/company_os}"
pnpm build >/dev/null
audit_before="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM audit.intents WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND action IN ('organization.unit.create','workforce.attendance.record','workforce.attendance.review','workforce.attendance.period.manage','workforce.leave.request','procurement.requisition.create','finance.journal.post','finance.receipt.apply','finance.cost.allocate')")"
outbox_before="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM integration.outbox WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND event_type IN ('organization.unit.created.v1','attendance.created.v1','attendance.approved.v1','attendance.rejected.v1','attendance_period.closed.v1','attendance_period.reopened.v1','leave_request.created.v1','requisition.created.v1','posted_journal.created.v1','receipt.created.v1','cost_allocation.created.v1')")"
pnpm test:e2e
audit_after="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM audit.intents WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND action IN ('organization.unit.create','workforce.attendance.record','workforce.attendance.review','workforce.attendance.period.manage','workforce.leave.request','procurement.requisition.create','finance.journal.post','finance.receipt.apply','finance.cost.allocate')")"
outbox_after="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM integration.outbox WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND event_type IN ('organization.unit.created.v1','attendance.created.v1','attendance.approved.v1','attendance.rejected.v1','attendance_period.closed.v1','attendance_period.reopened.v1','leave_request.created.v1','requisition.created.v1','posted_journal.created.v1','receipt.created.v1','cost_allocation.created.v1')")"
if (( audit_after - audit_before < 11 || outbox_after - outbox_before < 11 )); then
  echo 'E2E command did not atomically produce audit and outbox evidence' >&2
  exit 1
fi
