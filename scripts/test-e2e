#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"
docker compose up -d keycloak postgres
curl --fail --silent --retry 30 --retry-all-errors --retry-delay 2 --max-time 3 \
  http://127.0.0.1:8080/realms/company-os/.well-known/openid-configuration >/dev/null
./scripts/seed-demo >/dev/null
random_id=''
read -r random_id < /proc/sys/kernel/random/uuid
export E2E_USER_PASSWORD="${E2E_USER_PASSWORD:-${random_id//-/}}"
keycloak_admin=(docker compose exec -T keycloak /opt/keycloak/bin/kcadm.sh)
"${keycloak_admin[@]}" config credentials --server http://localhost:8080 --realm master \
  --user admin --password local-development-only >/dev/null
"${keycloak_admin[@]}" get users/profile -r company-os | jq \
  'if any(.attributes[]; .name == "tenant_id") then . else .attributes += [{"name":"tenant_id","displayName":"Tenant ID","permissions":{"view":["admin","user"],"edit":["admin"]},"multivalued":false}] end' | \
  "${keycloak_admin[@]}" update users/profile -r company-os -f -
existing_user="$("${keycloak_admin[@]}" get users -r company-os -q username=e2e-user --fields id --format csv --noquotes | tail -n 1)"
if [[ -n "$existing_user" ]]; then
  "${keycloak_admin[@]}" delete "users/$existing_user" -r company-os >/dev/null
fi
"${keycloak_admin[@]}" create users -r company-os -s username=e2e-user -s enabled=true \
  -s email=e2e-user@example.invalid -s emailVerified=true -s firstName=E2E -s lastName=User \
  -s 'attributes."tenant_id"=["11111111-1111-4111-8111-111111111111"]' >/dev/null
"${keycloak_admin[@]}" set-password -r company-os --username e2e-user --new-password "$E2E_USER_PASSWORD" >/dev/null
for role in organization-admin workforce-manager procurement-buyer finance-accountant; do
  "${keycloak_admin[@]}" add-roles -r company-os --uusername e2e-user --rolename "$role" >/dev/null
done
export SESSION_SECRET="${SESSION_SECRET:-local-e2e-session-secret-at-least-32-characters}"
export DATABASE_URL="${E2E_DATABASE_URL:-postgresql://company_os:local-development-only@127.0.0.1:5432/company_os}"
audit_before="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM audit.intents WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND action IN ('organization.unit.create','workforce.attendance.record','workforce.leave.request','procurement.requisition.create','finance.journal.post','finance.receipt.apply','finance.cost.allocate')")"
outbox_before="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM integration.outbox WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND event_type IN ('organization.unit.created.v1','attendance.created.v1','leave_request.created.v1','requisition.created.v1','posted_journal.created.v1','receipt.created.v1','cost_allocation.created.v1')")"
pnpm test:e2e
audit_after="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM audit.intents WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND action IN ('organization.unit.create','workforce.attendance.record','workforce.leave.request','procurement.requisition.create','finance.journal.post','finance.receipt.apply','finance.cost.allocate')")"
outbox_after="$(docker compose exec -T postgres psql -At -U company_os -d company_os -c \
  "SELECT count(*) FROM integration.outbox WHERE tenant_id='11111111-1111-4111-8111-111111111111' AND event_type IN ('organization.unit.created.v1','attendance.created.v1','leave_request.created.v1','requisition.created.v1','posted_journal.created.v1','receipt.created.v1','cost_allocation.created.v1')")"
if (( audit_after - audit_before < 7 || outbox_after - outbox_before < 7 )); then
  echo 'E2E command did not atomically produce audit and outbox evidence' >&2
  exit 1
fi
