#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifact_dir="${WEB_ARTIFACT_DIR:-$repo_dir/dist/web}"
runtime_dir="$artifact_dir/apps/web"

[[ -f "$runtime_dir/server.js" && -d "$runtime_dir/.next/static" && -d "$runtime_dir/public" ]] || exit 1
[[ -f "$artifact_dir/MANIFEST.sha256" && -f "$artifact_dir/ARTIFACT.sha256" && -f "$artifact_dir/SYMLINKS.manifest" ]] || exit 1
(
  cd "$artifact_dir"
  expected="$(tr -d '\n' < ARTIFACT.sha256)"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || exit 1
  [[ "$(sha256sum MANIFEST.sha256 | awk '{print $1}')" == "$expected" ]] || exit 1
  sha256sum -c MANIFEST.sha256 >/dev/null || exit 1
  manifest_files="$(wc -l < MANIFEST.sha256 | tr -d ' ')"
  actual_files="$(find . -type f ! -name MANIFEST.sha256 ! -name ARTIFACT.sha256 | wc -l | tr -d ' ')"
  [[ "$manifest_files" -eq "$actual_files" ]] || exit 1
  manifest_links=0
  while IFS=$'\t' read -r link target; do
    [[ -L "$link" && "$(readlink "$link")" == "$target" ]] || exit 1
    manifest_links=$((manifest_links + 1))
  done < SYMLINKS.manifest
  actual_links="$(find . -type l | wc -l | tr -d ' ')"
  [[ "$manifest_links" -eq "$actual_links" ]] || exit 1
)
