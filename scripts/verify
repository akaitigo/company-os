#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"

./scripts/verify-spec
./scripts/verify-product
pnpm format:check
pnpm lint
pnpm typecheck
pnpm test
pnpm build
docker compose config --quiet
./scripts/check-migrations
./scripts/check-keycloak-config
./scripts/test-web-artifact
git diff --check
