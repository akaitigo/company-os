#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
contract="$repo_dir/infra/config/deployment-contract-v1.json"
jq -e '
  .schemaVersion == 1 and
  (.contractVersion | type == "string" and length > 0) and
  (.profiles == ["DEV", "SMB"]) and
  (.timeoutSeconds | type == "number" and . >= 1 and . <= 30) and
  ([.fields[].name] | length == (unique | length)) and
  ([.fields[].name] | sort) == ([
    "DEPLOYMENT_PROFILE", "DATABASE_URL", "MIGRATION_DATABASE_URL", "OIDC_ISSUER",
    "OIDC_AUDIENCE", "OIDC_CLIENT_ID", "OIDC_REDIRECT_URI", "SESSION_SECRET",
    "MIGRATION_BACKUP_SIGNING_KEY", "API_INTERNAL_URL", "OTEL_EXPORTER_OTLP_ENDPOINT",
    "WEB_ARTIFACT_DIR", "S3_ENDPOINT", "S3_ACCESS_KEY", "S3_SECRET_KEY"
  ] | sort) and
  all(.fields[];
    (.name | test("^[A-Z][A-Z0-9_]+$")) and
    (.owner | type == "string" and length > 0) and
    (.secret | type == "boolean") and
    (.requiredIn | type == "array") and
    all(.requiredIn[]; . == "DEV" or . == "SMB")
  ) and
  (.fields | map(select(.name == "DATABASE_URL"))[0] | .owner == "runtime" and .secret and .requiredIn == ["DEV", "SMB"] and .kind == "postgres-url") and
  (.fields | map(select(.name == "MIGRATION_DATABASE_URL"))[0] | .owner == "migration-owner" and .secret and .requiredIn == ["SMB"] and .kind == "postgres-url") and
  all(.fields[] | select(.name == "SESSION_SECRET" or .name == "MIGRATION_BACKUP_SIGNING_KEY" or .name == "S3_SECRET_KEY"); .secret and .minLength == 32)
' "$contract" >/dev/null
echo 'Deployment contract policy passed.'
