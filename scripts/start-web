#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifact_dir="${WEB_ARTIFACT_DIR:-$repo_dir/dist/web}"
runtime_dir="$artifact_dir/apps/web"

fail() { echo "Web startup refused: $1" >&2; exit 78; }
[[ -f "$runtime_dir/server.js" ]] || fail 'standalone server.js is missing; run pnpm build.'
[[ -f "$artifact_dir/MANIFEST.sha256" && -f "$artifact_dir/ARTIFACT.sha256" ]] || fail 'artifact integrity manifest is missing.'
[[ -f "$artifact_dir/SYMLINKS.manifest" ]] || fail 'artifact symlink manifest is missing.'
[[ -d "$runtime_dir/.next/static" ]] || fail 'packaged static assets are missing.'
[[ -d "$runtime_dir/public" ]] || fail 'packaged public assets are missing.'

WEB_ARTIFACT_DIR="$artifact_dir" "$repo_dir/scripts/verify-web-artifact" || fail 'artifact checksum verification failed.'

if [[ -n "${SESSION_SECRET_FILE:-}" ]]; then
  [[ -z "${SESSION_SECRET:-}" ]] || fail 'SESSION_SECRET and SESSION_SECRET_FILE cannot both be set.'
  [[ -f "$SESSION_SECRET_FILE" ]] || fail 'SESSION_SECRET_FILE is not readable.'
  [[ "$(wc -c < "$SESSION_SECRET_FILE")" -le 8192 ]] || fail 'SESSION_SECRET_FILE exceeds 8192 bytes.'
  mapfile -t session_secret_lines < "$SESSION_SECRET_FILE"
  [[ "${#session_secret_lines[@]}" -eq 1 && -n "${session_secret_lines[0]}" ]] || fail 'SESSION_SECRET_FILE must contain exactly one non-empty line.'
  SESSION_SECRET="${session_secret_lines[0]}"
  unset session_secret_lines
  export SESSION_SECRET
fi
[[ -n "${SESSION_SECRET:-}" && ${#SESSION_SECRET} -ge 32 ]] || fail 'SESSION_SECRET must contain at least 32 characters.'
for variable in OIDC_ISSUER OIDC_CLIENT_ID OIDC_REDIRECT_URI API_INTERNAL_URL; do
  [[ -n "${!variable:-}" ]] || fail "$variable is required."
done
node -e '
  for (const name of ["OIDC_ISSUER", "OIDC_REDIRECT_URI", "API_INTERNAL_URL"]) {
    let url;
    try { url = new URL(process.env[name]); } catch { process.stderr.write(`${name} must be an absolute URL.\n`); process.exit(1); }
    if (["OIDC_ISSUER", "OIDC_REDIRECT_URI"].includes(name) && url.protocol !== "https:" && !["localhost", "127.0.0.1"].includes(url.hostname)) {
      process.stderr.write(`${name} must use HTTPS outside loopback development.\n`);
      process.exit(1);
    }
  }
' || fail 'runtime URL validation failed.'

export NODE_ENV=production
export HOSTNAME="${WEB_HOST:-0.0.0.0}"
export PORT="${PORT:-3000}"
cd "$runtime_dir"
exec node server.js
