NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://company_os:change-me@localhost:5432/company_os
OIDC_ISSUER=http://localhost:8080/realms/company-os
OIDC_AUDIENCE=company-os-api
OIDC_CLIENT_ID=company-os-web
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=replace-with-at-least-32-random-characters
API_INTERNAL_URL=http://127.0.0.1:3001
# Optional managed S3-compatible document adapter (not started by Compose).
S3_ENDPOINT=https://s3.example.invalid
S3_BUCKET=company-os
S3_ACCESS_KEY=replace-with-workload-identity-or-generated-key
S3_SECRET_KEY=replace-with-generated-secret
